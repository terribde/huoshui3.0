HOST=127.0.0.1
PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=swjtu-cache
REDIS_PASSWORD=replace-with-a-server-only-secret
CACHE_PREFIX=swjtu:prod:cache:v1:
CACHE_TTL_SECONDS=604800
CACHE_SYNC_SECONDS=3600
# Node >=22.13; server-local durable records with Redis summary caching.
ANALYTICS_ENABLED=false
ANALYTICS_DB_PATH=/var/lib/swjtu-cache/visits.sqlite
ANALYTICS_TIMEZONE=Asia/Tokyo
ANALYTICS_ALLOWED_ORIGINS=https://huoshui3.top,http://47.108.145.230
# Generate an independent random token (32+ chars); keep out of VITE_* variables.
ANALYTICS_READ_TOKEN=
